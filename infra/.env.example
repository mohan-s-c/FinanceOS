# Finance OS / APAR — environment template (V2).
# Copy to infra/.env (gitignored) and/or the per-app locations noted below.
# Real secrets (ERP/bank/API credentials) belong in a secret manager, NEVER in the repo.

# ---- Front-end (apps/web) — Vite reads VITE_* at build/dev time ----
# Put this in apps/web/.env.local for local dev.
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---- API (services/api) ----
FINANCEOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Global kill switch: when true, agents always escalate (no auto-action). Default true.
FINANCEOS_SUGGEST_ONLY=true

# ---- Phase 1+ (placeholders; unused in Phase 0) ----
# DATABASE_URL=postgresql://user:pass@localhost:5432/financeos   # -> secret manager
# LLM_PROVIDER=
# LLM_API_KEY=                                                    # -> secret manager
# ERP_VENDOR=mock        # mock | netsuite | sap | quickbooks | xero
# BANK_VENDOR=mock
